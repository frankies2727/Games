# VITE_VIBECHECK_API_URL: Optional. URL of the hosted VibeCheck brain
# (a Cloudflare Worker doing Gemini + Google Search grounding). When set, the
# VibeCheck project shows a "Live · grounded" data source. Leave empty to run on
# Wikipedia + local Ollama only. No secret key goes here — the Gemini key lives
# only inside the Worker. See docs/VIBECHECK_HOSTING.md.
VITE_VIBECHECK_API_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
